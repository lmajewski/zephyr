menuconfig OA_TC6
	bool "OPEN Alliance Technical Committee 6 (TC6) support"
	default n
	depends on ETH_LAN865X
	help
	  The LAN865X is a low power, 10BASE-T1S transceiver compliant with
	  the IEEE® 802.3cg-2019™ Ethernet standard for long reach, 10
	  Mbps single pair Ethernet (SPE).

	  Featuring an integrated media access control (MAC) and a PHY,
	  the LAN865X enables direct connectivity with a variety of controllers
	  via a serial peripheral inter-face (SPI).

if OA_TC6

config OA_TC6_RXTX_THREAD_STACK_SIZE
	int "Stack size for a thread that processes RXTX transmission"
	default 1024
	help
	  Size of the stack used for internal thread which is ran to
	  send and receive SPI data.

config OA_TC6_RXTX_THREAD_PRIO
	int "Priority for internal function to handle transmission"
	default 5
	help
	  Priority level for internal thread which is ran for OA TC6
	  SPI data transmission.

config OA_TC6_TX_POOL_SIZE
	int "Size of pool for OA TC6 TX SPI transfers"
	default 4
	help
	  Size of network buffer pool required for outgoing SPI data
	  transmission.

endif # OA_TC6
